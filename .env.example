# Meta Developer Model API (Muse)
# Get your API key from Meta Developer / Model API dashboard
META_API_KEY=your_meta_model_api_key_here
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark

# Optional fallback or alternative OpenAI-compatible provider
# OPENAI_API_KEY=your_openai_key_here

# Simulation mode (set to "false" when using live Meta Muse API key)
SIMULATION_MODE=false

